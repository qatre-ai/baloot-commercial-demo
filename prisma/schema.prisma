// ─────────────────────────────────────────────
// CLASS SCHEDULES - Weekly recurring & one-time
// Admin creates when opening a class registration
// ─────────────────────────────────────────────

/// Class schedule - represents when a class meets
/// Supports both recurring (weekly) and one-time sessions
model ClassSchedule {
  id            String    @id @default(cuid())
  courseId      String    // Which course this schedule belongs to
  instructorId  String    // Instructor teaching this session
  branchId      String?   // Which branch

  // ─── Schedule Timing ──────────────────────
  dayOfWeek     Int       // 0=Saturday, 1=Sunday, 2=Monday, 3=Tuesday, 4=Wednesday, 5=Thursday, 6=Friday (Persian week)
  startTime     String    // "14:00" - HH:mm format
  endTime       String    // "16:00" - HH:mm format

  // ─── Schedule Type ────────────────────────
  isRecurring   Boolean   @default(true)   // true = weekly repeating, false = one-time
  specificDate  DateTime?                  // For one-time sessions or makeup classes

  // ─── Room & Capacity ──────────────────────
  room          String?   // اتاق ۱، سالن اصلی، etc.
  capacity      Int?      // ظرفیت این جلسه خاص

  // ─── Status ───────────────────────────────
  status        String    @default("active")  // active | cancelled | completed
  cancelReason  String?   // دلیل لغو
  cancelledAt   DateTime?
  cancelledBy   String?   // Admin or instructor who cancelled

  // ─── Metadata ─────────────────────────────
  notes         String?   // یادداشت
  sessionNumber Int?      // شماره جلسه (مثلاً جلسه ۳ از ۸)

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  course        Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  instructor    Student   @relation("InstructorSchedules", fields: [instructorId], references: [id], onDelete: Cascade)
  branch        Branch?   @relation(fields: [branchId], references: [id])
  changeRequests ScheduleChangeRequest[]

  @@index([courseId])
  @@index([instructorId])
  @@index([branchId])
  @@index([dayOfWeek])
  @@index([status])
  @@index([isRecurring])
  @@index([specificDate])
}

// ─────────────────────────────────────────────
// SCHEDULE CHANGE REQUESTS
// Instructors request time changes or cancellations
// Admins approve/reject, changes propagate to student schedules
// ─────────────────────────────────────────────

/// Instructor requests for schedule changes
/// All requests stored in DB for future analysis
model ScheduleChangeRequest {
  id              String    @id @default(cuid())
  instructorId    String    // Instructor making the request
  scheduleId      String    // Which class schedule this refers to
  courseId        String    // Which course

  // ─── Request Type & Details ───────────────
  requestType     String    // time_change | cancellation | room_change | reschedule
  reason          String    // دلیل درخواست

  // ─── Proposed Changes (JSON) ──────────────
  proposedChanges String    // JSON: { dayOfWeek?, startTime?, endTime?, room?, specificDate? }

  // ─── Review Status ────────────────────────
  status          String    @default("pending")  // pending | approved | rejected
  adminResponse   String?   // پاسخ ادمین
  reviewedBy      String?   // Admin who reviewed
  reviewedAt      DateTime?

  // ─── Applied Changes ──────────────────────
  isApplied       Boolean   @default(false)  // Whether the change was applied to the schedule
  appliedAt       DateTime?

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  instructor      Student        @relation("InstructorChangeRequests", fields: [instructorId], references: [id], onDelete: Cascade)
  schedule        ClassSchedule  @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  course          Course         @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([instructorId])
  @@index([scheduleId])
  @@index([courseId])
  @@index([status])
  @@index([requestType])
  @@index([createdAt])
}

// ─────────────────────────────────────────────
// TESTIMONIALS / REVIEWS - نظرات و بازخوردها
// Admin/Super Admin approval required before publishing
// Google integration for authenticity (anti-fake)
// ─────────────────────────────────────────────

/// Testimonials/Reviews from students and visitors
/// Only published after admin/super admin approval
/// Google email integration for authenticity — shows username and Google avatar
model Testimonial {
  id              String    @id @default(cuid())

  // ─── Author Info ──────────────────────────
  name            String                          // نام نویسنده نظر
  email           String                          // ایمیل (ترجیحاً ایمیل گوگل)
  googleAvatarUrl String?                         // عکس پروفایل گوگل (برای اعتبار)
  googleEmail     String?                         // ایمیل گوگل (اگر متفاوت از ایمیل اصلی)
  studentId       String?                         // اگر هنرجو ثبت‌نام‌شده است

  // ─── Review Content ───────────────────────
  rating          Int       @default(5)           // ۱ تا ۵ ستاره
  titleFa         String?                         // عنوان نظر فارسی
  titleEn         String?                         // عنوان نظر انگلیسی
  contentFa       String                          // متن نظر فارسی
  contentEn       String?                         // متن نظر انگلیسی

  // ─── Context ──────────────────────────────
  courseId        String?                         // مربوط به چه دوره‌ای (اختیاری)
  workshopId      String?                         // مربوط به چه کارگاهی (اختیاری)
  instrument      String?                         // ساز مرتبط (اختیاری)

  // ─── Source ───────────────────────────────
  source          String    @default("contact")   // contact | google | direct | admin_added
  /// contact: از فرم تماس با ما
  /// google: از طریق ایمیل گوگل تأیید شده
  /// direct: مستقیم ثبت شده
  /// admin_added: ادمین اضافه کرده

  // ─── Admin Review & Publishing ────────────
  isPublished     Boolean   @default(false)        // آیا منتشر شده در سایت
  isApproved      Boolean   @default(false)        // آیا توسط ادمین/سوپر ادمین تأیید شده
  approvedBy      String?                          // کدام ادمین تأیید کرده
  approvedAt      DateTime?                        // زمان تأیید
  isFeatured      Boolean   @default(false)        // نظر ویژه (نمایش برتر)
  displayOrder    Int       @default(0)            // ترتیب نمایش

  // ─── Status ───────────────────────────────
  status          String    @default("pending")    // pending | approved | published | rejected | hidden
  rejectionReason String?                          // دلیل رد شدن (در صورت رد)
  adminNotes      String?                          // یادداشت داخلی ادمین

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([isPublished])
  @@index([isApproved])
  @@index([isFeatured])
  @@index([status])
  @@index([rating])
  @@index([source])
  @@index([studentId])
  @@index([courseId])
  @@index([displayOrder])
  @@index([createdAt])
}

// ─────────────────────────────────────────────
// INSTRUCTOR FEEDBACK - بازخورد اساتید
// Students rate instructors after course completion
// Critical for AI analysis: performance, firing, hiring decisions
// ─────────────────────────────────────────────

/// Student feedback/ratings for instructors
/// Used for AI analysis of instructor performance, hiring/firing decisions
model InstructorFeedback {
  id              String    @id @default(cuid())

  // ─── Who ──────────────────────────────────
  instructorId    String    // استادی که بازخورد درباره اوست
  studentId       String    // هنرجویی که بازخورد را داده

  // ─── Context ──────────────────────────────
  courseId        String?   // مربوط به چه دوره‌ای
  classScheduleId String?   // مربوط به چه کلاسی

  // ─── Rating & Feedback ────────────────────
  teachingQuality  Int      // کیفیت تدریس (1-5)
  punctuality      Int      // وقت‌شناسی (1-5)
  communication    Int      // ارتباط با هنرجو (1-5)
  overallRating    Int      // امتیاز کلی (1-5)
  commentFa        String?  // نظر فارسی
  commentEn        String?  // نظر انگلیسی

  // ─── Status ───────────────────────────────
  isAnonymous     Boolean   @default(false)  // آیا بازخورد ناشناس است
  status          String    @default("pending")  // pending | approved | hidden | flagged

  // ─── AI Analysis ──────────────────────────
  sentimentScore  Float?    // AI-calculated sentiment (-1 to 1)
  keywords        String?   // JSON array: AI-extracted keywords
  aiCategory      String?   // AI category: positive | negative | mixed | neutral

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  instructor      Student   @relation("InstructorReceivedFeedback", fields: [instructorId], references: [id], onDelete: Cascade)
  student         Student   @relation("StudentWrittenFeedback", fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([instructorId, studentId, courseId])
  @@index([instructorId])
  @@index([studentId])
  @@index([courseId])
  @@index([overallRating])
  @@index([status])
  @@index([createdAt])
}

// ─────────────────────────────────────────────
// ATTENDANCE - حضور و غیاب
// Track student attendance per session
// Critical for: churn prediction, engagement scoring, AI analytics
// ─────────────────────────────────────────────

/// Student attendance per class session
/// Used for AI churn prediction, engagement analysis, and reporting
model Attendance {
  id              String    @id @default(cuid())

  // ─── Who & Where ─────────────────────────
  studentId       String    // هنرجو
  courseId        String    // دوره
  classScheduleId String?   // کلاس (اختیاری)
  instructorId    String?   // استاد (denormalized for fast queries)

  // ─── Session Info ─────────────────────────
  sessionDate     String    // تاریخ جلسه (ISO string, display as Shamsi)
  sessionNumber   Int?      // شماره جلسه (مثلا جلسه ۳ از ۸)

  // ─── Attendance Status ────────────────────
  status          String    @default("present")  // present | absent | late | excused | makeup
  arrivalTime     String?   // زمان ورود (if late)
  notes           String?   // یادداشت

  // ─── Makeup Tracking ──────────────────────
  makeupForDate   String?   // اگر این جلسه جایگزین است، تاریخ جلسه اصلی
  isMakeup        Boolean   @default(false)  // آیا جلسه جایگزین (جبرانی) است

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  student         Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, courseId, sessionDate])
  @@index([studentId])
  @@index([courseId])
  @@index([instructorId])
  @@index([status])
  @@index([sessionDate])
  @@index([createdAt])
}

// ─────────────────────────────────────────────
// WEBSITE EVENTS - کلیک‌ها و تعاملات سایت
// Track page views, clicks, and interactions
// Critical for: AI-driven UX optimization, conversion analysis
// ─────────────────────────────────────────────

/// Website interaction events for analytics
/// All clicks, page views, and interactions are logged
model WebsiteEvent {
  id              String    @id @default(cuid())

  // ─── Who ──────────────────────────────────
  userId          String?   // If logged in
  sessionId       String?   // Browser session ID (for anonymous tracking)

  // ─── What ─────────────────────────────────
  eventType       String    // page_view | click | form_submit | scroll | video_play | cta_click | course_view | instructor_view | workshop_view | registration_start | registration_complete
  elementId       String?   // ID of the clicked element
  elementText     String?   // Text of the clicked element
  pagePath        String?   // URL path

  // ─── Context ──────────────────────────────
  referrer        String?   // Where did they come from
  utmSource       String?   // UTM source
  utmMedium       String?   // UTM medium
  utmCampaign     String?   // UTM campaign

  // ─── Device ───────────────────────────────
  deviceType      String?   // desktop | mobile | tablet
  browser         String?
  os              String?
  screenWidth     Int?
  language        String?   // fa | en

  // ─── Location ─────────────────────────────
  country         String?
  city            String?
  ipAddress       String?

  // ─── Duration ─────────────────────────────
  timeOnPage      Int?      // seconds spent on page
  scrollDepth     Float?    // 0-1 scroll percentage

  // ─── Related Entity ───────────────────────
  relatedEntityType String?  // course | workshop | instructor | blog_post
  relatedEntityId   String?  // ID of the related entity

  createdAt       DateTime  @default(now())

  @@index([eventType])
  @@index([userId])
  @@index([pagePath])
  @@index([createdAt])
  @@index([utmSource])
  @@index([relatedEntityType])
  @@index([relatedEntityId])
}

// ─────────────────────────────────────────────
// SESSION LOG - لاگ جلسات برگزار شده
// Records each class session that actually took place
// Critical for: instructor hours tracking, student attendance, AI analytics
// ─────────────────────────────────────────────

/// Log of class sessions that actually took place
/// Used for instructor hour tracking, attendance, and AI analytics
model SessionLog {
  id              String    @id @default(cuid())

  // ─── What Class ──────────────────────────
  courseId        String    // دوره
  classScheduleId String?   // برنامه کلاس (اختیاری)
  classCode       String?   // شناسه یکتای کلاس - for quick identification

  // ─── Who ──────────────────────────────────
  instructorId    String    // استاد
  branchId        String?   // شعبه

  // ─── When ─────────────────────────────────
  sessionDate     String    // تاریخ جلسه (ISO, display as Shamsi)
  startTime       String    // شروع - "14:00"
  endTime         String    // پایان - "16:00"
  sessionNumber   Int?      // شماره جلسه

  // ─── Attendance Summary ───────────────────
  totalEnrolled   Int       @default(0)  // تعداد ثبت‌نام‌شده
  totalPresent    Int       @default(0)  // تعداد حاضرین
  totalAbsent     Int       @default(0)  // تعداد غایبین
  totalLate       Int       @default(0)  // تعداد دیررسیده‌ها

  // ─── Session Details ──────────────────────
  sessionStatus   String    @default("completed")  // completed | cancelled | shortened | extended
  cancelReason    String?   // دلیل لغو (در صورت لغو)
  topics          String?   // JSON array: مباحث تدریس‌شده
  notes           String?   // یاددات

  // ─── Quality Tracking ─────────────────────
  instructorPresent Boolean  @default(true)  // آیا استاد حاضر بود
  startedOnTime   Boolean   @default(true)  // آیا به موقع شروع شد
  endedOnTime     Boolean   @default(true)  // آیا به موقع تمام شد

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([courseId])
  @@index([instructorId])
  @@index([branchId])
  @@index([sessionDate])
  @@index([sessionStatus])
  @@index([classCode])
  @@index([createdAt])
}
