// ─────────────────────────────────────────────
// BLOG SYSTEM - SEO-Optimized Content Marketing
// ─────────────────────────────────────────────

model BlogCategory {
  id            String   @id @default(cuid())
  nameFa        String
  nameEn        String
  slugFa        String   @unique
  slugEn        String   @unique
  descriptionFa String?
  descriptionEn String?
  color         String   @default("#8B2252")
  icon          String?
  order         Int      @default(0)
  isPublished   Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  posts         BlogPostToCategory[]

  @@index([order])
}

model BlogPost {
  id                String       @id @default(cuid())
  titleFa           String
  titleEn           String
  slugFa            String       @unique
  slugEn            String       @unique
  contentFa         String
  contentEn         String
  excerptFa         String?
  excerptEn         String?
  coverUrl          String?
  coverAltFa        String?
  coverAltEn        String?
  tags              String?      // JSON array of tags
  metaTitleFa       String?
  metaTitleEn       String?
  metaDescriptionFa String?
  metaDescriptionEn String?
  keywords          String?
  readingTime       Int          @default(0)
  authorId          String?
  sourceType        String       @default("manual")  // manual | ai_generated | ai_assisted | auto_published
  isPublished       Boolean      @default(false)
  isFeatured        Boolean      @default(false)
  isShowOnHome      Boolean      @default(false)
  isPinned          Boolean      @default(false)
  isNew             Boolean      @default(false)     // Auto-flagged if within 30 days of creation
  publishedAt       DateTime?
  viewCount         Int          @default(0)
  uniqueViewCount   Int          @default(0)
  shareCount        Int          @default(0)
  likeCount         Int          @default(0)
  avgReadTime       Float        @default(0)
  bounceRate        Float        @default(0)
  order             Int          @default(0)
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  categories        BlogPostToCategory[]
  author            Student?            @relation(fields: [authorId], references: [id])
  images            BlogImage[]
  dailyAnalytics    BlogPostDailyAnalytics[]
  viewLogs          BlogViewLog[]

  @@index([slugFa])
  @@index([slugEn])
  @@index([isPublished])
  @@index([isFeatured])
  @@index([isShowOnHome])
  @@index([isPinned])
  @@index([publishedAt])
  @@index([sourceType])
  @@index([createdAt])
}

/// Multiple image sizes per blog post
model BlogImage {
  id          String   @id @default(cuid())
  postId      String
  sizeKey     String   // thumbnail | small | medium | large | hero | og_image | square | wide
  url         String
  width       Int?
  height      Int?
  fileSize    Int?
  altFa       String?
  altEn       String?
  quality     Int      @default(80)
  format      String   @default("webp")
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  post        BlogPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([postId, sizeKey])
  @@index([postId])
  @@index([sizeKey])
}

model BlogPostToCategory {
  postId     String
  categoryId String
  assignedAt DateTime @default(now())

  post       BlogPost     @relation(fields: [postId], references: [id], onDelete: Cascade)
  category   BlogCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([postId, categoryId])
}

model BlogPostDailyAnalytics {
  id              String   @id @default(cuid())
  postId          String
  date            String   // YYYY-MM-DD
  views           Int      @default(0)
  uniqueViews     Int      @default(0)
  avgReadTime     Float    @default(0)
  avgReadProgress Float    @default(0)
  shares          Int      @default(0)
  likes           Int      @default(0)
  bounceRate      Float    @default(0)
  sourceDirect    Int      @default(0)
  sourceSearch    Int      @default(0)
  sourceSocial    Int      @default(0)
  sourceReferral  Int      @default(0)
  deviceDesktop   Int      @default(0)
  deviceMobile    Int      @default(0)
  deviceTablet    Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  post            BlogPost @relation(fields: [postId], references: [id])

  @@unique([postId, date])
  @@index([postId])
  @@index([date])
}

model BlogViewLog {
  id             String   @id @default(cuid())
  postId         String
  viewedAt       DateTime @default(now())
  readProgress   Float    @default(0)
  timeOnPage     Int      @default(0)
  referrer       String?
  source         String   @default("direct")
  deviceType     String   @default("desktop")
  userAgent      String?
  country        String?
  sessionId      String?
  createdAt      DateTime @default(now())

  post           BlogPost @relation(fields: [postId], references: [id])

  @@index([postId])
  @@index([viewedAt])
}

// ─────────────────────────────────────────────
// MEDIA LIBRARY
// ─────────────────────────────────────────────

model Media {
  id           String   @id @default(cuid())
  url          String
  altFa        String?
  altEn        String?
  title        String?
  type         String   @default("image")
  mimeType     String?
