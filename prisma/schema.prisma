  titleFa       String
  titleEn       String
  descriptionFa String?
  descriptionEn String?
  type          String   @default("practice")  // practice | theory | performance | composition
  difficulty    String   @default("beginner")  // beginner | intermediate | advanced
  courseId      String?
  instructorId  String?  // Student with role=instructor who created this
  dueDate       DateTime?
  isPublished   Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  course        Course?  @relation(fields: [courseId], references: [id])
  instructor    Student? @relation("InstructorExercises", fields: [instructorId], references: [id])
  submissions   StudentExercise[]

  @@index([courseId])
  @@index([instructorId])
  @@index([isPublished])
}

model StudentExercise {
  id          String    @id @default(cuid())
  studentId   String
  exerciseId  String
  status      String    @default("assigned")  // assigned | submitted | graded | late
  grade       Int?
  feedback    String?
  submittedAt DateTime?
  gradedAt    DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  student     Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  exercise    Exercise  @relation(fields: [exerciseId], references: [id], onDelete: Cascade)

  @@unique([studentId, exerciseId])
  @@index([studentId])
  @@index([exerciseId])
  @@index([status])
