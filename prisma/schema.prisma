generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ============================================
// مهر آوای بلوط - Database Schema v7.0
// Production-Ready, AI-Ready, Commercial-Grade
// Unified User Model + RBAC + Security + Blog System
// Smart fields, AI-ready analytics, Iran-optimized
// 3 Registration Methods + Tuition Tracking (NO online payment)
// Session ranges (exact or range) + Workshop reservations + Admin notifications
// v7: Extended Instructor Profile, Feedback, Attendance, Website Events, Session Logs, Class IDs
// ============================================

// ─────────────────────────────────────────────
// USERS - Unified model for Instructors & Students
// Structured for AI-driven business analysis
// ─────────────────────────────────────────────

/// Unified user model - both instructors (اساتید) and students (هنرجویان)
/// Rich structured data for AI automation and business intelligence
/// Iran-optimized: phone-centric, no email dependency, Shamsi dates
model Student {
  id                      String    @id @default(cuid())
  email                   String    @unique
  phone                   String    @default("")       // شماره تماس خود هنرجو - PRIMARY contact in Iran
  name                    String
  password                String    // hashed with SHA-256 + salt
  avatarUrl               String?
  
  // ─── User Category ─────────────────────────
  role                    String    @default("student") // student | instructor
  
  // ─── Personal Information ──────────────────
  dateOfBirth             String?   // ISO date string (store as ISO, display as Shamsi)
  gender                  String?   // male | female | other | prefer_not_to_say
  nationalId              String?   // کد ملی - for official records
  educationLevel          String?   // preschool | primary | middle_school | high_school | diploma | associate | bachelor | master | phd | other
  fieldOfStudy            String?   // رشته تحصیلی
  
  // ─── Music Profile ────────────────────────
  registrationInstrument  String?   // سازی که با آن ثبت‌نام کرده (مهم برای تحلیل هوشمند)
  primaryInstrument       String?   // ساز اصلی - piano | guitar | violin | setar | tar | kamancheh | drums | vocals | santur | oud | flute | daf | tonbak | other
  secondaryInstruments    String?   // JSON array: ["guitar", "piano"] یا "none"
  musicExperienceYears    Int?      // سال‌های تجربه موسیقی
  previousTraining        String?   // none | self_taught | private_tutor | music_school | university | online_courses
  musicGenres             String?   // JSON array: ["classical", "iranian_traditional", "pop", "jazz"]
  learningGoals           String?   // JSON: هدف از یادگیری - hobby | professional_career | teaching | performance | composition | exam_prep | self_improvement
  practiceHoursPerWeek    Int?      // ساعت تمرین هفتگی
  skillLevel              String?   // beginner | intermediate | advanced | professional
  instructorName          String?   // نام استاد فعلی یا قبلی
  instructorNameKnown     Boolean   @default(true)  // آیا نام استاد مشخص است؟
  
  // ─── Contact & Location ───────────────────
  address                 String?
  city                    String?
  province                String?
  emergencyContact        String?   // تماس اضطراری
  
  // ─── Parent/Guardian (for minors) ─────────
  parentName              String?
  parentPhone             String?   // شماره تماس ولی (جایگزین ایمیل - در ایران کاربردی‌تر)
  parentRelation          String?   // father | mother | guardian | other
  
  // ─── Business Intelligence ────────────────
  referralSource          String?   // instagram | telegram | google | friend | billboard | website | event | other
  referralDetail          String?   // جزئیات منبع ارجاع
  leadScore               Int       @default(0)     // AI-calculated lead score (0-100)
  customerLifetimeValue   Int       @default(0)     // کل پرداختی‌ها (تومان)
  churnRisk               String?   // low | medium | high - AI-predicted churn risk
  engagementScore         Int       @default(0)     // AI-calculated engagement score (0-100)
  preferredBranch         String?   // شعبه ترجیحی - for AI scheduling optimization
  
  // ─── Instructor-Specific Fields ───────────
  specialtyFa             String?   // تخصص فارسی
  specialtyEn             String?   // Specialty in English
  bioFa                   String?   // بیوگرافی فارسی
  bioEn                   String?   // Biography in English
  experience              String?   // سابقه تدریس
  socialLinks             String?   // JSON: {instagram, telegram, youtube, soundcloud}
  instructorOrder         Int       @default(0)     // Display order for instructors page
  isPublishedInstructor   Boolean   @default(false) // Show on instructors page?

  // ─── Instructor Extended Profile (AI-Ready) ─
  teachingInstruments     String?   // JSON array: سازهایی که تدریس می‌کند - ["piano","guitar"]
  certifications          String?   // JSON array: مدارک و گواهینامه‌ها - [{title,issuer,year}]
  hourlyRate              Int?      // حق الساعع به تومان - for AI revenue analysis
  availableDays           String?   // JSON array: روزهای_available - ["saturday","monday"]
  availableTimeRanges     String?   // JSON: {saturday: "14:00-20:00", monday: "10:00-18:00"}
  instructorRating        Float     @default(0)     // میانگین امتیاز از بازخورد هنرجویان (0-5)
  totalTeachingHours      Int       @default(0)     // کل ساعت تدریس - AI performance metric
  totalStudentsTaught     Int       @default(0)     // تعداد کل هنرجویان تدریس‌شده - for capacity planning
  hireDate                String?   // تاریخ استخدام (ISO string, display as Shamsi)
  contractType            String?   // full_time | part_time | hourly | contract | freelance
  instructorStatus        String    @default("active")  // active | on_leave | suspended | terminated
  feedbackSummary         String?   // JSON: AI-generated summary of all feedback - {positive:[], negative:[], score:4.2}
  performanceScore        Int       @default(0)     // AI-calculated performance score (0-100)
  
  // ─── Status & Tracking ────────────────────
  isActive                Boolean   @default(true)
  isVerified              Boolean   @default(false)  // Phone verified
  lastLogin               DateTime?
  lastLoginIp             String?
  notes                   String?   // Internal admin notes
  tags                    String?   // JSON array of admin tags for categorization
  registrationStatus      String    @default("approved") // pending | approved | rejected
  
  // ─── AI Automation Fields ─────────────────
  aiRecommendations       String?   // JSON: AI-generated course/workshop recommendations
  aiLastAnalysis          DateTime? // Last time AI analyzed this user
  aiSegmentTag            String?   // AI-assigned segment: active | at_risk | dormant | new | vip | champion
  aiChurnFactors          String?   // JSON: AI-identified churn factors
  aiNextBestAction        String?   // JSON: AI-suggested next action for retention
  
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  // ─── Relations ────────────────────────────
  tickets                 WorkshopTicket[]
  blogPosts               BlogPost[]
  enrollments             CourseEnrollment[]
  loginSessions           LoginSession[]
  exercises               StudentExercise[]
  payments                Payment[]
  taughtCourses           Course[]              @relation("InstructorCourses")  // Courses this instructor teaches
  classSchedules          ClassSchedule[]       @relation("InstructorSchedules")  // Scheduled class sessions
  scheduleChangeRequests  ScheduleChangeRequest[] @relation("InstructorChangeRequests")  // Instructor change requests
  instructorExercises     Exercise[]           @relation("InstructorExercises")  // Exercises created by this instructor
  givenFeedback           InstructorFeedback[] @relation("InstructorReceivedFeedback")  // Feedback received by this instructor
  writtenFeedback         InstructorFeedback[] @relation("StudentWrittenFeedback")  // Feedback written by this student
  attendances             Attendance[]         // Student attendance records

  @@index([email])
  @@index([phone])
  @@index([role])
  @@index([isActive])
  @@index([primaryInstrument])
  @@index([registrationInstrument])
  @@index([referralSource])
  @@index([gender])
  @@index([city])
  @@index([leadScore])
  @@index([aiSegmentTag])
  @@index([instructorNameKnown])
  @@index([createdAt])
  @@index([registrationStatus])
}

// ─────────────────────────────────────────────
// AUTHENTICATION & AUTHORIZATION
// ─────────────────────────────────────────────

/// Super Admin & Sub-Admin accounts with full RBAC support
model Admin {
  id                    String    @id @default(cuid())
  email                 String    @unique
  name                  String
  password              String    // hashed with SHA-256 + salt
  phone                 String?
  role                  String    @default("admin")  // super_admin | admin | editor
  avatarUrl             String?
  isActive              Boolean   @default(true)
  twoFactorEnabled      Boolean   @default(false)
  twoFactorSecret       String?
  mustChangePassword    Boolean   @default(true)
  failedLoginAttempts   Int       @default(0)
  lockedUntil           DateTime?
  lastLoginAt           DateTime?
  lastLoginIp           String?
  createdBy             String?
  notes                 String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  permissions           AdminPermission[]
  auditLogs             AuditLog[]
  loginSessions         LoginSession[]
  devices               AdminDevice[]
  sentMessages          AdminMessage[]       @relation("SentMessages")
  receivedMessages      AdminMessage[]       @relation("ReceivedMessages")
  backups               BackupRecord[]
  intrusionAlerts       IntrusionAlert[]     @relation("TargetAdmin")

  @@index([email])
  @@index([role])
  @@index([isActive])
}

/// Granular resource+action permissions for RBAC
model AdminPermission {
  id          String   @id @default(cuid())
  adminId     String
  resource    String   // users | courses | workshops | blog | announcements | instructors | branches | media | backups | settings | messages | analytics
  action      String   // create | read | update | delete | publish | manage | feature
  granted     Boolean  @default(true)
  grantedBy   String?
  createdAt   DateTime @default(now())

  admin       Admin    @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@unique([adminId, resource, action])
  @@index([adminId])
  @@index([resource])
}

/// Audit trail for all admin actions
model AuditLog {
  id            String   @id @default(cuid())
  adminId       String?
  action        String
  entity        String
  entityId      String?
  entityName    String?
  details       String?  // JSON string with change details
  ipAddress     String?
  userAgent     String?
  severity      String   @default("info")  // info | warning | critical
  createdAt     DateTime @default(now())

  admin         Admin?   @relation(fields: [adminId], references: [id], onDelete: SetNull)

  @@index([adminId])
  @@index([entity])
  @@index([severity])
  @@index([createdAt])
}

/// Active and past login sessions
model LoginSession {
  id            String    @id @default(cuid())
  adminId       String?
  studentId     String?
  userType      String    // admin | student | instructor
  sessionToken  String?   @unique
  ipAddress     String
  userAgent     String?
  country       String?
  city          String?
  deviceType    String?
  browser       String?
  os            String?
  deviceFingerprint String?
  isActive      Boolean   @default(true)
  loginAt       DateTime  @default(now())
  logoutAt      DateTime?
  expiresAt     DateTime?

  admin         Admin?    @relation(fields: [adminId], references: [id], onDelete: SetNull)
  student       Student?  @relation(fields: [studentId], references: [id], onDelete: SetNull)

  @@index([adminId])
  @@index([studentId])
  @@index([isActive])
  @@index([ipAddress])
  @@index([loginAt])
}

/// Whitelisted devices for admin access control
model AdminDevice {
  id              String   @id @default(cuid())
  adminId         String
  deviceName      String
  deviceType      String   // desktop | mobile | tablet
  browser         String?
  os              String?
  deviceFingerprint String?
  ipAddress       String?
  isApproved      Boolean  @default(false)
  lastUsedAt      DateTime?
  approvedBy      String?
  approvedAt      DateTime?
  createdAt       DateTime @default(now())

  admin           Admin    @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId])
  @@index([isApproved])
  @@index([deviceFingerprint])
}

/// Intrusion detection alerts
model IntrusionAlert {
  id              String    @id @default(cuid())
  targetAdminId   String?
  attemptType     String    // brute_force | credential_stuffing | suspicious_device | unknown_device | suspicious_ip | rate_limit
  ipAddress       String
  userAgent       String?
  country         String?
  city            String?
  deviceFingerprint String?
  attemptCount    Int       @default(1)
  details         String?
  isResolved      Boolean   @default(false)
  resolvedBy      String?
  resolvedAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  targetAdmin     Admin?    @relation("TargetAdmin", fields: [targetAdminId], references: [id], onDelete: SetNull)

  @@index([targetAdminId])
  @@index([isResolved])
  @@index([ipAddress])
  @@index([createdAt])
}

/// Internal messaging system between admins
model AdminMessage {
  id              String    @id @default(cuid())
  senderId        String
  recipientId     String
  subject         String
  content         String
  priority        String    @default("normal")  // low | normal | high | urgent
  status          String    @default("sent")     // sent | delivered | read | archived
  parentMessageId String?
  isSystemMessage Boolean   @default(false)
  readAt          DateTime?
  archivedBy      String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  sender          Admin     @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  recipient       Admin     @relation("ReceivedMessages", fields: [recipientId], references: [id], onDelete: Cascade)

  @@index([senderId])
  @@index([recipientId])
  @@index([status])
  @@index([createdAt])
  @@index([recipientId, status])
}

/// Backup records - manual and automatic
model BackupRecord {
  id              String   @id @default(cuid())
  performedBy     String?
  backupType      String   // manual | auto_daily | auto_weekly | before_update
  fileSize        Int?
  fileKey         String?
  checksum        String?
  checksumAlgorithm String? @default("sha256")
  encryptionUsed  Boolean  @default(false)
  status          String   @default("completed")  // in_progress | completed | failed | restoring | verifying
  notes           String?
  createdAt       DateTime @default(now())

  admin           Admin?   @relation(fields: [performedBy], references: [id], onDelete: SetNull)

  @@index([performedBy])
  @@index([backupType])
  @@index([createdAt])
  @@index([status])
}

// ─────────────────────────────────────────────
// PENDING REGISTRATIONS - Online submissions awaiting admin approval
// When approved, a Student account is created with username=phone, password=nationalId
// ─────────────────────────────────────────────

/// Online registration submissions that await admin review
/// All data is preserved for future analysis and process evaluation
model PendingRegistration {
  id                      String    @id @default(cuid())
  
  // ─── Core Info (Required) ──────────────────
  name                    String    // نام و نام خانوادگی
  phone                   String    // شماره موبایل - will become username
  nationalId              String    // کد ملی - will become default password
  email                   String?   // ایمیل (optional in Iran)
  role                    String    @default("student") // student | instructor
  
  // ─── Personal Information ──────────────────
  dateOfBirth             String?   // ISO date string
  gender                  String?   // male | female | other | prefer_not_to_say
  educationLevel          String?   // preschool | primary | middle_school | high_school | diploma | associate | bachelor | master | phd | other
  fieldOfStudy            String?   // رشته تحصیلی
  
  // ─── Music Profile ────────────────────────
  registrationInstrument  String?   // سازی که با آن ثبت‌نام کرده
  primaryInstrument       String?   // ساز اصلی
  secondaryInstruments    String?   // JSON array
  musicExperienceYears    Int?      // سال‌های تجربه موسیقی
  previousTraining        String?   // none | self_taught | private_tutor | music_school | university | online_courses
  musicGenres             String?   // JSON array
  learningGoals           String?   // JSON array
  practiceHoursPerWeek    Int?      // ساعت تمرین هفتگی
  skillLevel              String?   // beginner | intermediate | advanced | professional
  instructorName          String?   // نام استاد فعلی یا قبلی
  instructorNameKnown     Boolean   @default(true)
  
  // ─── Contact & Location ───────────────────
  address                 String?
  city                    String?
  province                String?
  emergencyContact        String?   // تماس اضطراری
  preferredBranch         String?   // شعبه ترجیحی
  
  // ─── Parent/Guardian (for minors) ─────────
  parentName              String?
  parentPhone             String?
  parentRelation          String?   // father | mother | guardian | other
  
  // ─── Business Intelligence ────────────────
  referralSource          String?   // instagram | telegram | google | friend | billboard | website | event | other
  referralDetail          String?   // جزئیات منبع ارجاع
  
  // ─── Instructor-Specific Fields ───────────
  specialtyFa             String?
  specialtyEn             String?
  bioFa                   String?
  bioEn                   String?
  experience              String?
  socialLinks             String?   // JSON
  
  // ─── Review Status ─────────────────────────
  status                  String    @default("pending")  // pending | approved | rejected
  reviewedBy              String?   // Admin who reviewed
  reviewedAt              DateTime?
  adminNotes              String?   // یادداشت ادمین
  rejectionReason         String?   // دلیل رد درخواست
  
  // ─── After Approval ────────────────────────
  createdUserId           String?   // ID of the Student created after approval
  
  // ─── Submission Metadata ───────────────────
  ipAddress               String?
  userAgent               String?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  @@index([status])
  @@index([phone])
  @@index([nationalId])
  @@index([createdAt])
  @@index([reviewedAt])
}

// ─────────────────────────────────────────────
// COURSES & ENROLLMENTS
// ─────────────────────────────────────────────

model Course {
  id            String   @id @default(cuid())
  classCode     String?  @unique  // شناسه یکتای کلاس - برای جلوگیری از تشابه و سردرگمی
  titleFa       String
  titleEn       String
  descriptionFa String?
  descriptionEn String?
  category      String?   // instrument | vocal | theory | production
  instrument    String?   // piano | guitar | violin | drums | vocals | setar | etc.
  level         String    @default("all")  // beginner | intermediate | advanced | all
  classType     String    @default("group")  // private | group — خصوصی یا گروهی
  duration      String?
  sessionsMin       Int?       // حداقل تعداد جلسات (مثلا ۳)
  sessionsMax       Int?       // حداکثر تعداد جلسات (مثلا ۵) — اگر مساوی sessionsMin باشد، تعداد دقیق است
  price             Int?
  imageUrl      String?
  coverUrl      String?
  isFeatured    Boolean   @default(false)
  isShowOnHome  Boolean   @default(false)
  isNew         Boolean   @default(false)      // Marked as "new" (within 30 days)
  isPublished   Boolean   @default(false)
  branchId      String?
  instructorId  String?   // Linked instructor (Student with role=instructor)

  // ─── Registration Control ────────────────
  registrationOpen       Boolean   @default(true)   // آیا ثبت‌نام باز است؟
  registrationOpenAt     DateTime?                  // زمان شروع ثبت‌نام
  registrationCloseAt    DateTime?                  // زمان پایان ثبت‌نام
  maxCapacity            Int?                        // حداکثر ظرفیت کلاس

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  branch        Branch?              @relation(fields: [branchId], references: [id])
  instructor    Student?             @relation("InstructorCourses", fields: [instructorId], references: [id])
  enrollments   CourseEnrollment[]
  schedules     ClassSchedule[]
  changeRequests ScheduleChangeRequest[]
  exercises     Exercise[]

  @@index([isPublished])
  @@index([isFeatured])
  @@index([isShowOnHome])
  @@index([instrument])
  @@index([level])
  @@index([classType])
  @@index([registrationOpen])
}

model CourseEnrollment {
  id                    String    @id @default(cuid())
  studentId             String
  courseId              String
  status                String     @default("active")  // active | completed | paused | dropped
  progress              Int        @default(0)         // 0-100%
  enrolledAt            DateTime   @default(now())
  completedAt           DateTime?
  notes                 String?

  // ─── Registration Method (3 methods) ─────
  registrationMethod    String     @default("online")  // online | phone | in_person
  /// For online: student fills the form → automatically 'online'
  /// For phone/in_person: admin fills the form and specifies which method
  registeredByAdminId   String?    // If admin registered, which admin did it

  // ─── Tuition & Payment ───────────────────
  tuitionAmount         Int?       // مبلغ شهریه (تومان)
  paymentStatus         String     @default("unpaid")  // unpaid | paid | partial | waived
  /// unpaid: ثبت‌نام شده، هنوز تسویه نشده (پیش‌فرض)
  /// paid: تسویه شده (ادمین تایید کرده)
  /// partial: پرداخت جزئی (قسطی)
  /// waived: معاف از پرداخت
  paidAt                DateTime?  // زمان تسویه حساب
  paymentDueDate        DateTime?  // مهلت پرداخت شهریه
  paymentRef            String?    // شماره رسید / مرجع پرداخت (دستی توسط ادمین)

  // ─── Admin Edit Tracking ──────────────────
  lastEditedByAdminId   String?    // Last admin who edited this enrollment
  lastEditedAt          DateTime?  // When it was last edited by admin

  student               Student    @relation(fields: [studentId], references: [id], onDelete: Cascade)
  course                Course     @relation(fields: [courseId], references: [id], onDelete: Cascade)
  payments              Payment[]

  @@unique([studentId, courseId])
  @@index([studentId])
  @@index([courseId])
  @@index([status])
  @@index([registrationMethod])
  @@index([paymentStatus])
  @@index([paidAt])
}

// ─────────────────────────────────────────────
// WORKSHOPS
// ─────────────────────────────────────────────

model Workshop {
  id            String   @id @default(cuid())
  titleFa       String
  titleEn       String
  descriptionFa String?
  descriptionEn String?
  instructorFa  String
  instructorEn  String
  date          DateTime
  startTime     String?
  endTime       String?
  price         Int?
  discountPrice Int?
  totalSeats    Int      @default(30)
  reservedSeats Int      @default(0)
  imageUrl      String?
  coverUrl      String?
  category      String?
  locationFa    String?
  locationEn    String?
  requirementsFa String?
  requirementsEn String?
  highlightsFa  String?
  highlightsEn  String?
  contactPhone  String?
  registrationDeadline DateTime?
  isHot         Boolean  @default(false)
  isFeatured    Boolean  @default(false)
  isShowOnHome  Boolean  @default(false)
  isNew         Boolean  @default(false)     // Within 30 days of creation
  isPublished   Boolean  @default(false)
  branchId      String?

  // ─── Registration Control ────────────────
  registrationOpen       Boolean   @default(true)   // آیا ثبت‌نام باز است؟
  registrationOpenAt     DateTime?                  // زمان شروع ثبت‌نام
  registrationCloseAt    DateTime?                  // زمان پایان ثبت‌نام

  createdAt     DateTime @default(now())
  updatedAt     DateTime  @updatedAt

  branch        Branch?           @relation(fields: [branchId], references: [id])
  tickets       WorkshopTicket[]

  @@index([isPublished])
  @@index([isFeatured])
  @@index([isShowOnHome])
  @@index([date])
  @@index([registrationOpen])
}

model WorkshopTicket {
  id                    String    @id @default(cuid())
  studentId             String
  workshopId            String
  seatNumber            Int?
  status                String    @default("reserved") // reserved | paid | cancelled | attended
  amount                Int?

  // ─── Registration Method ──────────────────
  registrationMethod    String    @default("online")  // online | phone | in_person
  registeredByAdminId   String?   // If admin registered

  // ─── Payment Reference (no online gateway) ──
  paymentRef            String?    // شماره رسید / مرجع پرداخت (دستی توسط ادمین)
  paidAt                DateTime?

  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  student               Student   @relation(fields: [studentId], references: [id])
  workshop              Workshop  @relation(fields: [workshopId], references: [id])

  @@unique([studentId, workshopId])
  @@index([studentId])
  @@index([workshopId])
  @@index([status])
  @@index([registrationMethod])
}

// ─────────────────────────────────────────────
// ANNOUNCEMENTS / NEWS
// ─────────────────────────────────────────────

model Announcement {
  id            String   @id @default(cuid())
  titleFa       String
  titleEn       String
  contentFa     String?
  contentEn     String?
  type          String   @default("info")   // info | workshop | course | event | urgent | promo
  priority      Int      @default(0)
  imageUrl      String?
  coverUrl      String?  // Optimized cover image
  isPublished   Boolean  @default(false)
  isFeatured    Boolean  @default(false)
  isShowOnHome  Boolean  @default(false)
  isNew         Boolean  @default(false)     // Within 30 days
  isPinned      Boolean  @default(false)
  startsAt      DateTime?
  expiresAt     DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([isPublished])
  @@index([isFeatured])
  @@index([isShowOnHome])
  @@index([type])
  @@index([priority])
}

// ─────────────────────────────────────────────
