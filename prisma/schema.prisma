  key       String   @unique
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─────────────────────────────────────────────
// PAYMENTS
// ─────────────────────────────────────────────

model Payment {
  id                    String    @id @default(cuid())
  studentId             String
  amount                Int       // مبلغ به تومان
  type                  String    // course | workshop | registration | other
  status                String    @default("pending")  // pending | paid | failed | refunded | overdue
  referenceId           String?   // شماره تراکنش
  description           String?
  relatedId             String?   // ID of the related course/workshop
  paidAt                DateTime?

  // ─── Enhanced Payment Fields ──────────────
  paymentType           String    @default("full")     // full | installment | partial
  paymentMethod         String?   // cash | card_transfer | online_gateway | cheque | other
  paymentRef            String?   // شماره رسید / مرجع پرداخت (دستی توسط ادمین)
  notes                 String?   // یادداشت پرداخت

  // ─── Installment Support ─────────────────
  installmentNumber     Int?      // شماره قسط (مثلا ۱ از ۳)
  totalInstallments     Int?      // تعداد کل اقساط
  installmentPlanId     String?   // شناسه طرح قسطی
  dueDate               DateTime? // مهلت پرداخت این قسط

  // ─── Relations ────────────────────────────
  enrollmentId          String?   // Related course enrollment
  ticketId              String?   // Related workshop ticket
  receivedBy            String?   // Admin who received the payment
  createdBy             String?   // Admin who created the record

  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  student               Student           @relation(fields: [studentId], references: [id], onDelete: Cascade)
  enrollment            CourseEnrollment?  @relation(fields: [enrollmentId], references: [id])

  @@index([studentId])
  @@index([status])
  @@index([type])
  @@index([createdAt])
  @@index([paymentType])
  @@index([paymentMethod])
  @@index([installmentPlanId])
  @@index([enrollmentId])
}

// ─────────────────────────────────────────────
// EXERCISES & STUDENT WORK
// ─────────────────────────────────────────────

model Exercise {
